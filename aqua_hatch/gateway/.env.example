# Development gateway only. Replace with real user/device auth before production.
DEV_ACCESS_TOKEN=replace-with-a-random-token-at-least-16-characters
DEVICE_ID=incubator-01
SIMULATE_DEVICE=1
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
# Hardware: set SIMULATE_DEVICE=0 and configure MQTT.
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_FILE=
# Separate ESP32-S3 CAM. Reachable HTTPS gateway origin (no trailing /api path).
CAMERA_ID=incubator-01-camera
CAMERA_PUBLIC_BASE_URL=https://your-gateway.example.com
# Optional trained model: no pretrained fish-counting model is bundled.
LARVAE_MODEL_PATH=
LARVAE_CLASS_NAME=larva
